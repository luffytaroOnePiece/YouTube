{
  "manifest_version": 3,
  "name": "YT Story Poster",
  "version": "1.0.0",
  "description": "Generate stunning Instagram Story posters from any YouTube video with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["poster.html"],
      "matches": ["*://www.youtube.com/*"]
    }
  ]
}
